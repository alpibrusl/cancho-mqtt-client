edition 5;

// `will` -- connect to a broker with a will, wait for CONNACK, then end the connection one of two ways.
//
//     will <ipv4> <port> <will-topic> <will-payload> <retain> <end> [<client-id>]
//
// <retain> is 0 or 1: whether the broker keeps the will as the topic's last value once it publishes it. <end> is `drop`, which closes the
// socket without a DISCONNECT (the broker then publishes the will, 3.1.2-8), or `bye`, which sends DISCONNECT first (the broker discards the
// will, 3.14.4-3). The will is at QoS 0.
//
// Exit status: 0 done; 2 wrong arguments; 3 the broker refused the connection or sent something the client refused; 4 could not connect;
// 5 the connection failed. The example of `docs/design.md` section 16, slice 4; its authority row is `net_out` and nothing else.

import std.buffer;
import std.io;
import mqttc.codec;
import mqttc.client;
import examples.pump;

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn run[&h, &c, &t, &p, &i](heap: &!h Heap, conn: &!c Conn, topic: &t [byte], payload: &p [byte], retain: int, bye: bool, id: &i [byte]) -> [heap, conn_read, conn_write] int {
    let ev = box_slice(heap, 6 * 4, 0);
    let c0 = client.new(heap, 65536);
    let (c1, o1, rc) = client.open(heap, c0, buffer.empty(heap, 64), id, 0, true, "", "", topic, payload, 0, retain, 0);
    var status = 0;
    var cl = c1;
    var out = o1;
    if rc != 0 {
        status = 3;
    }
    if status == 0 {
        let (o2, sent) = pump.send_out(conn, out);
        out = o2;
        if !sent {
            status = 5;
        }
    }
    var waiting = status == 0;
    while waiting {
        borrow mut ev as &!ew in {
            let (c2, o3, n, s) = pump.pump(heap, conn, cl, 0, contents(ew), out);
            cl = c2;
            out = o3;
            if s != 0 {
                status = 5;
                waiting = false;
            } else if n > 0 {
                if contents(ew)[0] != client.ev_connected() {
                    status = 3;
                }
                waiting = false;
            }
        }
    }
    if status == 0 && bye {
        let (c4, o6, r2) = client.disconnect(heap, cl, out, 0);
        cl = c4;
        out = o6;
        let (o7, sent3) = pump.send_out(conn, out);
        out = o7;
        if !sent3 {
            status = 5;
        }
    }
    client.drop(heap, cl);
    buffer.drop(heap, out);
    unbox_slice(heap, ev);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(fs);
    release(clock);
    var status = 2;
    borrow args as &g in {
        if arg_count(g) >= 7 {
            let port = number_of(arg(g, 2));
            let retain = number_of(arg(g, 5));
            let end = arg(g, 6);
            let bye = len(end) == 3 && end[0] == byte_of(98) && end[1] == byte_of(121) && end[2] == byte_of(101);
            let drop = len(end) == 4 && end[0] == byte_of(100) && end[1] == byte_of(114) && end[2] == byte_of(111) && end[3] == byte_of(112);
            if port > 0 && port < 65536 && retain >= 0 && retain <= 1 && (bye || drop) {
                status = 4;
                borrow net as &nn in {
                    match tcp_connect(nn, arg(g, 1), port) {
                        Dialed::Ok(cn) => {
                            var conn = cn;
                            borrow mut conn as &!ch in {
                                borrow mut heap as &!h in {
                                    var id = "will";
                                    if arg_count(g) >= 8 {
                                        status = run(h, ch, arg(g, 3), arg(g, 4), retain, bye, arg(g, 7));
                                    } else {
                                        status = run(h, ch, arg(g, 3), arg(g, 4), retain, bye, id);
                                    }
                                }
                            }
                            conn_close(conn);
                        }
                        Dialed::Failed(e) => {
                            status = 4;
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(args);
    release(io);
    release(heap);
    return status;
}

edition 5;

import std.buffer;
import std.test;
import std.vec;
import mqttc.codec;
import mqttc.client;

fn nibble(c: int) -> [] int {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return 0 - 1;
}

// Write the bytes `hex` spells at the front of `dst`; answers how many.
fn unhex[&d, &t](dst: &!d [byte], hex: &t [byte]) -> [] int {
    var i = 0;
    while i + 1 < len(hex) {
        dst[i / 2] = byte_of(nibble(int_of(hex[i])) * 16 + nibble(int_of(hex[i + 1])));
        i = i + 2;
    }
    return len(hex) / 2;
}

// Are the `n` bytes of `got` exactly the bytes `hex` spells?
fn matches[&g, &t](got: &g [byte], n: int, hex: &t [byte]) -> [] bool {
    if n != len(hex) / 2 {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(got[i]) != nibble(int_of(hex[2 * i])) * 16 + nibble(int_of(hex[2 * i + 1])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- a rig: the machine, what it wrote, and every event it has reported ------------------------
//
// Every helper takes the rig and answers it, and the ones named `check_*` and `do_*` make their assertion inside, so a test reads as a
// sequence: `r = do_feed(heap, r, "20020000", 100, 4, 1);`.

res struct Rig {
    c: client.Client,
    out: buffer.Buffer,
    log: vec.Vec[int],
}

fn rig[&h](heap: &!h Heap, max_packet: int) -> [heap] Rig {
    return Rig { c: client.new(heap, max_packet), out: buffer.empty(heap, 64), log: vec.empty(heap, 24, 0) };
}

fn rig_drop[&h](heap: &!h Heap, r: Rig) -> [heap] int {
    let Rig { c, out, log } = r;
    client.drop(heap, c);
    buffer.drop(heap, out);
    vec.drop(heap, log);
    return 0;
}

fn check_state(r: Rig, want: int) -> [] Rig {
    let Rig { c, out, log } = r;
    borrow c as &cr in {
        test.assert_eq(client.state(cr), want);
    }
    return Rig { c: c, out: out, log: log };
}

// What the machine has written is exactly `hex` (empty: nothing); then it is forgotten.
fn check_wrote[&t](r: Rig, hex: &t [byte]) -> [] Rig {
    let Rig { c, out, log } = r;
    var o = out;
    borrow o as &ob in {
        test.assert(matches(buffer.bytes(ob), buffer.size(ob), hex));
    }
    borrow mut o as &!ow in {
        buffer.clear(ow);
    }
    return Rig { c: c, out: o, log: log };
}

// Field `f` (0 kind, 1 a, ... 5 e) of event `i` is `want`.
fn check_ev(r: Rig, i: int, f: int, want: int) -> [] Rig {
    let Rig { c, out, log } = r;
    borrow log as &lr in {
        test.assert_eq(vec.get(lr, 6 * i + f), want);
    }
    return Rig { c: c, out: out, log: log };
}

fn check_count(r: Rig, want: int) -> [] Rig {
    let Rig { c, out, log } = r;
    borrow log as &lr in {
        test.assert_eq(vec.size(lr) / 6, want);
    }
    return Rig { c: c, out: out, log: log };
}

// The inbox holds `size` bytes and the byte at `at` is `want`.
fn check_inbox(r: Rig, size: int, at: int, want: int) -> [] Rig {
    let Rig { c, out, log } = r;
    borrow c as &cr in {
        let box = client.inbox(cr);
        test.assert_eq(len(box), size);
        if size > 0 {
            test.assert_eq(int_of(box[at]), want);
        }
    }
    return Rig { c: c, out: out, log: log };
}

fn clear_inbox(r: Rig) -> [] Rig {
    let Rig { c, out, log } = r;
    var cc = c;
    borrow mut cc as &!cw in {
        client.clear_inbox(cw);
    }
    return Rig { c: cc, out: out, log: log };
}

// Forget what the machine has written.
fn wipe(r: Rig) -> [] Rig {
    let Rig { c, out, log } = r;
    var o = out;
    borrow mut o as &!ow in {
        buffer.clear(ow);
    }
    return Rig { c: c, out: o, log: log };
}

// Assert `got == want`, unless `want` is the sentinel meaning "any answer" (the sweeps).
fn expect(got: int, want: int) -> [] int {
    if want != 0 - 99999 {
        test.assert_eq(got, want);
    }
    return 0;
}

fn do_open[&h](heap: &!h Heap, r: Rig, keepalive: int, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.open(heap, c, out, "c", keepalive, true, "", "", "", "", 0, 0, now);
    test.assert_eq(rc, want);
    return Rig { c: c1, out: o1, log: log };
}

// Feed `bytes` with room for `room` events, expect `want` events reported; they join the log.
fn do_feed_raw[&h, &b](heap: &!h Heap, r: Rig, bytes: &b [byte], now: int, room: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let table = box_slice(heap, 6 * room, 0);
    var lg = log;
    var cc = c;
    var oo = out;
    borrow mut table as &!tw in {
        let (c1, o1, k) = client.feed(heap, cc, bytes, now, contents(tw), oo);
        cc = c1;
        oo = o1;
        if want >= 0 {
            test.assert_eq(k, want);
        }
        var i = 0;
        while i < 6 * k {
            lg = vec.push(heap, lg, contents(tw)[i]);
            i = i + 1;
        }
    }
    unbox_slice(heap, table);
    return Rig { c: cc, out: oo, log: lg };
}

// The same with the bytes `hex` spells.
fn do_feed[&h, &t](heap: &!h Heap, r: Rig, hex: &t [byte], now: int, room: int, want: int) -> [heap] Rig {
    region a {
        let b = alloc_slice[a](len(hex) / 2 + 1, byte_of(0));
        let used = unhex(b, hex);
        return do_feed_raw(heap, r, b[0..used], now, room, want);
    }
}

// Tick at `now`; the wait it answers is `want`.
fn do_tick[&h](heap: &!h Heap, r: Rig, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, w) = client.tick(heap, c, out, now);
    expect(w, want);
    return Rig { c: c1, out: o1, log: log };
}

// Open with a chosen clean-session flag.
fn do_open_session[&h](heap: &!h Heap, r: Rig, keepalive: int, clean: bool, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.open(heap, c, out, "c", keepalive, clean, "", "", "", "", 0, 0, now);
    expect(rc, want);
    return Rig { c: c1, out: o1, log: log };
}

fn do_disconnect[&h](heap: &!h Heap, r: Rig, now: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.disconnect(heap, c, out, now);
    test.assert_eq(rc, 0);
    return Rig { c: c1, out: o1, log: log };
}

fn check_inflight(r: Rig, want: int) -> [] Rig {
    let Rig { c, out, log } = r;
    borrow c as &cr in {
        test.assert_eq(client.inflight(cr), want);
    }
    return Rig { c: c, out: out, log: log };
}

fn do_window(r: Rig, n: int) -> [] Rig {
    let Rig { c, out, log } = r;
    return Rig { c: client.set_window(c, n), out: out, log: log };
}

fn do_resend[&h](heap: &!h Heap, r: Rig, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, n) = client.resend(heap, c, out, now);
    test.assert_eq(n, want);
    return Rig { c: c1, out: o1, log: log };
}

// A QoS `qos` publish of a payload of `n` bytes.
fn do_publish_big[&h](heap: &!h Heap, r: Rig, n: int, qos: int, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    var cc = c;
    var oo = out;
    region a {
        let payload = alloc_slice[a](n, byte_of(120));
        let (c1, o1, rc) = client.publish(heap, cc, oo, "a/b", payload, qos, 0, now);
        cc = c1;
        oo = o1;
        expect(rc, want);
    }
    return Rig { c: cc, out: oo, log: log };
}

fn do_publish[&h, &t, &p](heap: &!h Heap, r: Rig, topic: &t [byte], payload: &p [byte], qos: int, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.publish(heap, c, out, topic, payload, qos, 0, now);
    expect(rc, want);
    return Rig { c: c1, out: o1, log: log };
}

// The caller reports the connection gone.
fn do_lost(r: Rig) -> [] Rig {
    let Rig { c, out, log } = r;
    return Rig { c: client.lost(c), out: out, log: log };
}

// OPEN with a will: topic, message, QoS, retain; the answer must be `want`.
fn do_open_will[&h, &t, &m](heap: &!h Heap, r: Rig, topic: &t [byte], message: &m [byte], qos: int, retain: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.open(heap, c, out, "c", 0, true, "", "", topic, message, qos, retain, 0);
    expect(rc, want);
    return Rig { c: c1, out: o1, log: log };
}

// PUBLISH with the retain flag `retain`.
fn do_publish_retain[&h, &t, &p](heap: &!h Heap, r: Rig, topic: &t [byte], payload: &p [byte], qos: int, retain: int, now: int, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    let (c1, o1, rc) = client.publish(heap, c, out, topic, payload, qos, retain, now);
    expect(rc, want);
    return Rig { c: c1, out: o1, log: log };
}

// SUBSCRIBE (or UNSUBSCRIBE) to the one filter `text` at QoS `qos`; the packet id (or refusal) is `want`.
fn do_sub[&h, &t](heap: &!h Heap, r: Rig, text: &t [byte], qos: int, now: int, subscribe: bool, want: int) -> [heap] Rig {
    let Rig { c, out, log } = r;
    var cc = c;
    var oo = out;
    region a {
        let table = alloc_slice[a](3, 0);
        table[0] = 0;
        table[1] = len(text);
        table[2] = qos;
        if subscribe {
            let (c1, o1, p) = client.subscribe(heap, cc, oo, text, table, 1, now);
            cc = c1;
            oo = o1;
            expect(p, want);
        } else {
            let (c1, o1, p) = client.unsubscribe(heap, cc, oo, text, table, 1, now);
            cc = c1;
            oo = o1;
            expect(p, want);
        }
    }
    return Rig { c: cc, out: oo, log: log };
}

// A rig that has opened (keep-alive in seconds) at time 0 and been answered with CONNACK 0 at time 100; nothing is left in `out`.
fn connected[&h](heap: &!h Heap, keepalive: int, max_packet: int) -> [heap] Rig {
    var r = rig(heap, max_packet);
    r = do_open(heap, r, keepalive, 0, 0);
    r = do_feed(heap, r, "20020000", 100, 4, 1);
    r = check_state(r, client.s_connected());
    // Start the test with nothing written and no events reported: the Connected event is not the test's.
    let Rig { c, out, log } = wipe(r);
    vec.drop(heap, log);
    return Rig { c: c, out: out, log: vec.empty(heap, 24, 0) };
}

// ---- tests -------------------------------------------------------------------------------------

pub fn test_open_and_connack[&h](heap: &!h Heap) -> [heap] int {
    var r = rig(heap, 1024);
    r = do_open(heap, r, 60, 1000, 0);
    r = check_wrote(r, "100D00044D5154540402003C000163");
    r = check_state(r, client.s_connecting());
    // A second open while connecting is refused; the machine is unchanged.
    r = do_open(heap, r, 60, 1000, codec.e_state());
    r = check_state(r, client.s_connecting());
    // CONNACK, session present.
    r = do_feed(heap, r, "20020100", 1500, 4, 1);
    r = check_ev(r, 0, 0, client.ev_connected());
    r = check_ev(r, 0, 1, 1);
    r = check_state(r, client.s_connected());
    // A second CONNACK is a protocol violation: refused, closed.
    r = do_feed(heap, r, "20020000", 1600, 4, 1);
    r = check_ev(r, 1, 0, client.ev_refused());
    r = check_ev(r, 1, 1, codec.e_unexpected());
    r = check_state(r, client.s_closed());
    // A closed machine takes no input.
    r = do_feed(heap, r, "20020000", 1700, 4, 0);
    rig_drop(heap, r);
    return 0;
}

pub fn test_connack_refused[&h](heap: &!h Heap) -> [heap] int {
    var r = rig(heap, 1024);
    r = do_open(heap, r, 60, 0, 0);
    r = do_feed(heap, r, "20020005", 10, 4, 1);
    r = check_ev(r, 0, 0, client.ev_connack_refused());
    r = check_ev(r, 0, 1, 5);
    r = check_state(r, client.s_closed());
    rig_drop(heap, r);
    return 0;
}

pub fn test_nothing_before_connack[&h](heap: &!h Heap) -> [heap] int {
    var r = rig(heap, 1024);
    r = do_publish(heap, r, "a/b", "hi", 0, 5, codec.e_state());
    r = do_sub(heap, r, "a/#", 1, 5, true, codec.e_state());
    r = do_open(heap, r, 60, 0, 0);
    // Opened but not answered: still nothing but CONNECT has gone out.
    r = check_wrote(r, "100D00044D5154540402003C000163");
    r = do_publish(heap, r, "a/b", "hi", 0, 5, codec.e_state());
    r = do_sub(heap, r, "a/#", 1, 5, true, codec.e_state());
    r = check_wrote(r, "");
    // A PUBLISH before CONNACK is not allowed.
    r = do_feed(heap, r, "30070003612F626869", 5, 4, 1);
    r = check_ev(r, 0, 0, client.ev_refused());
    r = check_ev(r, 0, 1, codec.e_unexpected());
    r = check_state(r, client.s_closed());
    rig_drop(heap, r);
    return 0;
}

pub fn test_publish_subscribe_unsubscribe[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 60, 1024);
    // PUBLISH at QoS 0: exact bytes. QoS 3 is an argument error, QoS 2 is the client's own refusal, a wildcard in the name the codec's.
    r = do_publish(heap, r, "a/b", "hi", 0, 200, 0);
    r = check_wrote(r, "30070003612F626869");
    r = do_publish(heap, r, "a/b", "hi", 3, 200, codec.e_argument());
    r = do_publish(heap, r, "a/b", "hi", 2, 200, codec.e_qos2());
    r = do_publish(heap, r, "a/#", "hi", 0, 200, codec.e_topic());
    r = check_wrote(r, "");
    // SUBSCRIBE "a/#" at QoS 1: packet id 1; a second gets 2.
    r = do_sub(heap, r, "a/#", 1, 300, true, 1);
    r = check_wrote(r, "820800010003612F2301");
    r = do_sub(heap, r, "b/+", 0, 300, true, 2);
    r = check_wrote(r, "820800020003622F2B00");
    // The broker's answer: packet id 1, granted QoS 1.
    r = do_feed(heap, r, "9003000101", 310, 4, 1);
    r = check_ev(r, 0, 0, client.ev_subscribed());
    r = check_ev(r, 0, 1, 1);
    r = check_ev(r, 0, 2, 1);
    r = check_ev(r, 0, 3, 1);
    // UNSUBSCRIBE: packet id 3, answered.
    r = do_sub(heap, r, "a/#", 0, 320, false, 3);
    r = check_wrote(r, "A20700030003612F23");
    r = do_feed(heap, r, "B0020003", 330, 4, 1);
    r = check_ev(r, 1, 0, client.ev_unsubscribed());
    r = check_ev(r, 1, 1, 3);
    rig_drop(heap, r);
    return 0;
}

pub fn test_incoming_publish_in_fragments[&h](heap: &!h Heap) -> [heap] int {
    // QoS 1, retained: topic t, payload x, packet id 5, a byte at a time. One event when the last byte arrives, then the PUBACK.
    var r = connected(heap, 60, 1024);
    r = do_feed(heap, r, "33", 400, 4, 0);
    r = do_feed(heap, r, "06", 401, 4, 0);
    r = do_feed(heap, r, "0001", 402, 4, 0);
    r = do_feed(heap, r, "74", 403, 4, 0);
    r = do_feed(heap, r, "0005", 404, 4, 0);
    r = check_wrote(r, "");
    r = do_feed(heap, r, "78", 410, 4, 1);
    r = check_ev(r, 0, 0, client.ev_message());
    r = check_ev(r, 0, 1, 0);
    r = check_ev(r, 0, 2, 1);
    r = check_ev(r, 0, 3, 1);
    r = check_ev(r, 0, 4, 1);
    // qos 1 and retain: 1 + 4 * 1
    r = check_ev(r, 0, 5, 5);
    r = check_wrote(r, "40020005");
    // The inbox holds the topic then the payload, where the event says.
    r = check_inbox(r, 2, 0, 116);
    r = check_inbox(r, 2, 1, 120);
    r = clear_inbox(r);
    r = check_inbox(r, 0, 0, 0);
    rig_drop(heap, r);
    return 0;
}

pub fn test_two_packets_and_a_small_event_table[&h](heap: &!h Heap) -> [heap] int {
    // Two QoS 0 messages in one feed, room for one event: the second stays inside until the next feed.
    var r = connected(heap, 60, 1024);
    r = do_feed(heap, r, "300400017478300400017479", 500, 1, 1);
    r = do_feed(heap, r, "", 500, 1, 1);
    r = do_feed(heap, r, "", 500, 1, 0);
    r = check_count(r, 2);
    // Topic and payload of the first at 0 and 1, of the second at 2 and 3.
    r = check_ev(r, 0, 1, 0);
    r = check_ev(r, 0, 3, 1);
    r = check_ev(r, 1, 1, 2);
    r = check_ev(r, 1, 3, 3);
    // QoS 0 needs no PUBACK.
    r = check_wrote(r, "");
    rig_drop(heap, r);
    return 0;
}

pub fn test_keepalive[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 10, 1024);
    // Quiet for less than the keep-alive: nothing is sent, and tick says how long to wait (last sent at 0, due at 10000).
    r = do_tick(heap, r, 5000, 5000);
    r = check_wrote(r, "");
    // At the keep-alive: PINGREQ, and the grace (half the keep-alive) starts.
    r = do_tick(heap, r, 10000, 5000);
    r = check_wrote(r, "C000");
    // Inside the grace: nothing more.
    r = do_tick(heap, r, 12000, 3000);
    r = check_wrote(r, "");
    // PINGRESP clears it; the next PINGREQ is a keep-alive after the last one was sent.
    r = do_feed(heap, r, "D000", 12500, 4, 0);
    r = do_tick(heap, r, 12500, 7500);
    r = check_wrote(r, "");
    r = do_tick(heap, r, 20000, 5000);
    r = check_wrote(r, "C000");
    // Silence through the grace: the broker is declared silent and the machine closes.
    r = do_tick(heap, r, 25000, codec.e_keepalive());
    r = check_state(r, client.s_closed());
    rig_drop(heap, r);
    // No keep-alive, no pings.
    var q = connected(heap, 0, 1024);
    q = do_tick(heap, q, 99999999, client.idle_ms());
    q = check_wrote(q, "");
    rig_drop(heap, q);
    return 0;
}

// Any packet from the broker shows it is alive, not only PINGRESP.
pub fn test_any_packet_counts_as_alive[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 10, 1024);
    r = do_tick(heap, r, 10000, 5000);
    r = do_feed(heap, r, "300400017478", 11000, 4, 1);
    r = do_tick(heap, r, 16000, 4000);
    r = check_state(r, client.s_connected());
    rig_drop(heap, r);
    return 0;
}

// A broker packet that breaks a rule is an event and a closed connection.
fn refuses[&h, &t](heap: &!h Heap, hex: &t [byte], max_packet: int, code: int) -> [heap] int {
    var r = connected(heap, 60, max_packet);
    r = do_feed(heap, r, hex, 600, 4, 1);
    r = check_ev(r, 0, 0, client.ev_refused());
    r = check_ev(r, 0, 1, code);
    r = check_state(r, client.s_closed());
    rig_drop(heap, r);
    return 0;
}

pub fn test_refusals[&h](heap: &!h Heap) -> [heap] int {
    // A reserved packet type, a bad length, a packet over the bound, QoS 2, a packet id of 0, a PUBACK that is too short.
    refuses(heap, "FF00", 1024, codec.e_malformed());
    refuses(heap, "30FFFFFFFF", 1024, codec.bad_length());
    refuses(heap, "30FF7F", 64, codec.too_large());
    refuses(heap, "3406000174000578", 1024, codec.e_qos2());
    refuses(heap, "40020000", 1024, codec.e_packet_id());
    refuses(heap, "400101", 1024, codec.e_malformed());
    // A packet the broker never sends.
    refuses(heap, "C000", 1024, codec.e_unexpected());
    // The QoS 2 handshake.
    refuses(heap, "50020001", 1024, codec.e_qos2());
    return 0;
}

pub fn test_disconnect[&h](heap: &!h Heap) -> [heap] int {
    let r0 = connected(heap, 60, 1024);
    let Rig { c, out, log } = r0;
    let (c1, o1, rc) = client.disconnect(heap, c, out, 700);
    test.assert_eq(rc, 0);
    var r = Rig { c: c1, out: o1, log: log };
    r = check_wrote(r, "E000");
    r = check_state(r, client.s_closed());
    r = do_publish(heap, r, "a/b", "hi", 0, 800, codec.e_state());
    rig_drop(heap, r);
    return 0;
}

pub fn test_qos1_publish_and_ack[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 60, 1024);
    // QoS 1: the packet id comes back, the exact bytes go out, the message is held.
    r = do_publish(heap, r, "a/b", "hi", 1, 200, 1);
    r = check_wrote(r, "32090003612F6200016869");
    r = check_inflight(r, 1);
    r = do_publish(heap, r, "a/b", "hi", 1, 210, 2);
    r = check_wrote(r, "32090003612F6200026869");
    r = check_inflight(r, 2);
    // PUBACK 1 frees the first, and says so.
    r = do_feed(heap, r, "40020001", 220, 4, 1);
    r = check_ev(r, 0, 0, client.ev_acked());
    r = check_ev(r, 0, 1, 1);
    r = check_ev(r, 0, 2, 1);
    r = check_inflight(r, 1);
    // The same PUBACK again names nothing held: reported (b = 0), ignored.
    r = do_feed(heap, r, "40020001", 230, 4, 1);
    r = check_ev(r, 1, 1, 1);
    r = check_ev(r, 1, 2, 0);
    r = check_inflight(r, 1);
    r = do_feed(heap, r, "40020002", 240, 4, 1);
    r = check_inflight(r, 0);
    rig_drop(heap, r);
    return 0;
}

pub fn test_window_and_queue_bounds[&h](heap: &!h Heap) -> [heap] int {
    // A window of two: the third waits for an ack, and then gets the next id.
    var r = connected(heap, 60, 1024);
    r = do_window(r, 2);
    r = do_publish(heap, r, "a/b", "hi", 1, 200, 1);
    r = do_publish(heap, r, "a/b", "hi", 1, 200, 2);
    r = do_publish(heap, r, "a/b", "hi", 1, 200, codec.e_window());
    r = do_publish(heap, r, "a/b", "hi", 0, 200, 0);
    r = check_inflight(r, 2);
    r = do_feed(heap, r, "40020001", 210, 4, 1);
    r = do_publish(heap, r, "a/b", "hi", 1, 220, 3);
    rig_drop(heap, r);
    // The held bytes are bounded: eight messages of 8,000 bytes fit under 65,536, the ninth does not.
    var q = connected(heap, 60, 16384);
    var i = 0;
    while i < 8 {
        q = do_publish_big(heap, q, 8000, 1, 300, i + 1);
        i = i + 1;
    }
    q = do_publish_big(heap, q, 8000, 1, 300, codec.e_queue_full());
    q = check_inflight(q, 8);
    // QoS 0 is not held, so it is not bounded by it.
    q = do_publish_big(heap, q, 8000, 0, 300, 0);
    rig_drop(heap, q);
    return 0;
}

pub fn test_resend_sets_dup_on_what_is_held[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 60, 1024);
    r = do_publish(heap, r, "a/b", "hi", 1, 200, 1);
    r = do_publish(heap, r, "a/b", "hi", 1, 210, 2);
    r = do_feed(heap, r, "40020001", 220, 4, 1);
    r = wipe(r);
    // Only the second is still held; it goes out again with DUP (0x32 -> 0x3A) and the same id.
    r = do_resend(heap, r, 230, 1);
    r = check_wrote(r, "3A090003612F6200026869");
    // Nothing held, nothing to resend.
    r = do_feed(heap, r, "40020002", 240, 4, 1);
    r = do_resend(heap, r, 250, 0);
    r = check_wrote(r, "");
    rig_drop(heap, r);
    // Not connected: refused.
    var c = rig(heap, 1024);
    c = do_resend(heap, c, 0, codec.e_state());
    rig_drop(heap, c);
    return 0;
}

pub fn test_sessions_decide_what_is_kept[&h](heap: &!h Heap) -> [heap] int {
    // A clean session starts with nothing held.
    var a = connected(heap, 60, 1024);
    a = do_publish(heap, a, "a/b", "hi", 1, 200, 1);
    a = do_disconnect(heap, a, 210);
    a = do_open_session(heap, a, 60, true, 300, 0);
    a = check_inflight(a, 0);
    rig_drop(heap, a);
    // A kept session, which the broker says it kept (session present): the message is still held, and goes out again.
    var b = rig(heap, 1024);
    b = do_open_session(heap, b, 60, false, 0, 0);
    b = do_feed(heap, b, "20020100", 10, 4, 1);
    b = do_publish(heap, b, "a/b", "hi", 1, 200, 1);
    b = do_disconnect(heap, b, 210);
    b = do_open_session(heap, b, 60, false, 300, 0);
    b = do_feed(heap, b, "20020100", 310, 4, 1);
    b = check_inflight(b, 1);
    b = wipe(b);
    b = do_resend(heap, b, 320, 1);
    b = check_wrote(b, "3A090003612F6200016869");
    rig_drop(heap, b);
    // A kept session the broker does not have (session present 0): what was held can never be acknowledged, so it is dropped.
    var c = rig(heap, 1024);
    c = do_open_session(heap, c, 60, false, 0, 0);
    c = do_feed(heap, c, "20020100", 10, 4, 1);
    c = do_publish(heap, c, "a/b", "hi", 1, 200, 1);
    c = do_disconnect(heap, c, 210);
    c = do_open_session(heap, c, 60, false, 300, 0);
    c = do_feed(heap, c, "20020000", 310, 4, 1);
    c = check_inflight(c, 0);
    rig_drop(heap, c);
    return 0;
}

// Packet ids wrap at 65,535 and skip any id a held message still uses (2.3.1). One message stays unacknowledged under id 1; the other
// 65,534 ids are used and acknowledged; the next publish would be 1 again, so it takes 2.
pub fn test_packet_ids_skip_what_is_held[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 0, 1024);
    r = do_publish(heap, r, "t", "x", 1, 100, 1);
    var id = 2;
    while id <= 65535 {
        r = do_publish(heap, r, "t", "x", 1, 100, id);
        region a {
            let ack = alloc_slice[a](4, byte_of(0));
            ack[0] = byte_of(64);
            ack[1] = byte_of(2);
            ack[2] = byte_of(id / 256);
            ack[3] = byte_of(id % 256);
            r = do_feed_raw(heap, r, ack, 100, 1, 1);
        }
        r = wipe(r);
        id = id + 1;
    }
    r = check_inflight(r, 1);
    r = do_publish(heap, r, "t", "x", 1, 100, 2);
    rig_drop(heap, r);
    return 0;
}

// A will rides in CONNECT with its QoS and retain flag; a will that breaks a rule is refused and the machine stays closed (3.1.2-9 to 3.1.2-15).
pub fn test_will_rides_in_connect[&h](heap: &!h Heap) -> [heap] int {
    var r = rig(heap, 1024);
    r = do_open_will(heap, r, "w/t", "bye", 2, 0, codec.e_qos2());
    r = do_open_will(heap, r, "w/t", "bye", 3, 0, codec.e_argument());
    r = do_open_will(heap, r, "w/t", "bye", 0, 2, codec.e_argument());
    r = do_open_will(heap, r, "w/#", "bye", 0, 0, codec.e_topic());
    r = do_open_will(heap, r, "", "bye", 0, 0, codec.e_argument());
    r = do_open_will(heap, r, "", "", 0, 1, codec.e_argument());
    r = check_state(r, client.s_closed());
    r = check_wrote(r, "");
    // QoS 1, retained: the will flag (4), QoS 1 (8) and retain (32) join clean session (2) in the connect flags, 0x2E.
    r = do_open_will(heap, r, "w/t", "bye", 1, 1, 0);
    r = check_wrote(r, "101700044D515454042E00000001630003772F740003627965");
    r = check_state(r, client.s_connecting());
    rig_drop(heap, r);
    // A will at QoS 0, not retained, with an empty message.
    var q = rig(heap, 1024);
    q = do_open_will(heap, q, "w/t", "", 0, 0, 0);
    q = check_wrote(q, "101400044D515454040600000001630003772F740000");
    rig_drop(heap, q);
    return 0;
}

// The retain flag goes out on PUBLISH at both QoS levels, and an incoming retained PUBLISH says so in the event (`e` = QoS + 4 * retain).
pub fn test_retain_flag_both_ways[&h](heap: &!h Heap) -> [heap] int {
    var r = connected(heap, 60, 1024);
    r = do_publish_retain(heap, r, "a/b", "hi", 0, 1, 100, 0);
    r = check_wrote(r, "31070003612F626869");
    r = do_publish_retain(heap, r, "a/b", "hi", 1, 1, 101, 1);
    r = check_wrote(r, "33090003612F6200016869");
    r = do_publish_retain(heap, r, "a/b", "hi", 0, 0, 102, 0);
    r = check_wrote(r, "30070003612F626869");
    // Anything but 0 or 1 is refused and nothing is written.
    r = do_publish_retain(heap, r, "a/b", "hi", 0, 2, 103, codec.e_argument());
    r = do_publish_retain(heap, r, "a/b", "hi", 0, 0 - 1, 103, codec.e_argument());
    r = check_wrote(r, "");
    // An empty retained payload is how a retained message is cleared (3.3.1-10).
    r = do_publish_retain(heap, r, "a/b", "", 0, 1, 104, 0);
    r = check_wrote(r, "31050003612F62");
    // In: QoS 0 retained, then QoS 0 live.
    r = do_feed(heap, r, "310400017478", 200, 4, 1);
    r = check_ev(r, 0, 5, 4);
    r = do_feed(heap, r, "300400017478", 201, 4, 1);
    r = check_ev(r, 1, 5, 0);
    rig_drop(heap, r);
    return 0;
}

// `lost` closes the machine and keeps the session: the held message, the ids and the inbox stay; a half-read packet does not, so the CONNACK of
// the next connection is read from its first byte.
pub fn test_lost_keeps_the_session_and_drops_half_a_packet[&h](heap: &!h Heap) -> [heap] int {
    var r = rig(heap, 1024);
    r = do_open_session(heap, r, 60, false, 0, 0);
    r = do_feed(heap, r, "20020000", 10, 4, 1);
    r = do_publish(heap, r, "a/b", "hi", 1, 20, 1);
    r = check_inflight(r, 1);
    // Half of an incoming PUBLISH, then the connection dies.
    r = do_feed(heap, r, "3005", 30, 4, 0);
    r = do_lost(r);
    r = check_state(r, client.s_closed());
    r = check_inflight(r, 1);
    // Lost again, and on a machine that never opened: nothing changes.
    r = do_lost(r);
    r = check_state(r, client.s_closed());
    var fresh = do_lost(rig(heap, 1024));
    fresh = check_state(fresh, client.s_closed());
    rig_drop(heap, fresh);
    // The next connection keeps the session: the CONNACK is read whole, then the held message goes again with DUP and the id it had.
    r = wipe(r);
    r = do_open_session(heap, r, 60, false, 100, 0);
    r = do_feed(heap, r, "20020100", 110, 4, 1);
    r = check_ev(r, 1, 0, client.ev_connected());
    r = check_ev(r, 1, 1, 1);
    r = wipe(r);
    r = do_resend(heap, r, 120, 1);
    r = check_wrote(r, "3A090003612F6200016869");
    // The next new message does not reuse the held id.
    r = do_publish(heap, r, "a/b", "hi", 1, 130, 2);
    rig_drop(heap, r);
    return 0;
}

pub fn test_backoff_doubles_caps_and_refuses() -> [] int {
    test.assert_eq(client.backoff_ms(100, 5000, 0), 100);
    test.assert_eq(client.backoff_ms(100, 5000, 1), 200);
    test.assert_eq(client.backoff_ms(100, 5000, 2), 400);
    test.assert_eq(client.backoff_ms(100, 5000, 5), 3200);
    test.assert_eq(client.backoff_ms(100, 5000, 6), 5000);
    test.assert_eq(client.backoff_ms(100, 5000, 7), 5000);
    // A ceiling that is not a power-of-two multiple of the base is still the ceiling, never above it.
    test.assert_eq(client.backoff_ms(1000, 2500, 2), 2500);
    test.assert_eq(client.backoff_ms(7, 7, 100000), 7);
    test.assert_eq(client.backoff_ms(60000, 3600000, 100000), 3600000);
    test.assert_eq(client.backoff_ms(1, 3600000, 2000000000), 3600000);
    // The arguments' bounds.
    test.assert_eq(client.backoff_ms(0, 5000, 0), codec.e_argument());
    test.assert_eq(client.backoff_ms(60001, 3600000, 0), codec.e_argument());
    test.assert_eq(client.backoff_ms(100, 99, 0), codec.e_argument());
    test.assert_eq(client.backoff_ms(100, 3600001, 0), codec.e_argument());
    test.assert_eq(client.backoff_ms(100, 5000, 0 - 1), codec.e_argument());
    return 0;
}

// ---- no input reaches a trap -------------------------------------------------------------------

fn next(seed: int) -> [] int {
    return (seed * 1103515245 + 12345) % 2147483648;
}

fn corpus(i: int) -> [] &static [byte] {
    if i == 0 {
        return "20020100";
    }
    if i == 1 {
        return "30070003612F626869";
    }
    if i == 2 {
        return "3306000174000578";
    }
    if i == 3 {
        return "9006000700000180";
    }
    if i == 4 {
        return "40020102";
    }
    if i == 5 {
        return "B0020001";
    }
    if i == 6 {
        return "D000";
    }
    if i == 7 {
        return "3A06000174000578";
    }
    if i == 8 {
        return "40020001";
    }
    return "40020002";
}

pub fn test_no_input_reaches_a_trap[&h](heap: &!h Heap) -> [heap] int {
    var seed = 4242;
    var round = 0;
    while round < 300 {
        var r = rig(heap, 128);
        seed = next(seed);
        if seed / 256 % 4 != 0 {
            r = do_open(heap, r, seed / 256 % 5, round * 10, 0);
        }
        var step = 0;
        while step < 12 {
            seed = next(seed);
            let what = seed / 256 % 6;
            let now = round * 10 + step * 4000;
            if what == 0 {
                // A valid packet of the corpus.
                r = do_feed(heap, r, corpus(seed / 4096 % 10), now, 2, 0 - 1);
            } else if what == 1 {
                // Random bytes in a random chunk.
                region a {
                    let b = alloc_slice[a](24, byte_of(0));
                    var i = 0;
                    while i < len(b) {
                        seed = next(seed);
                        b[i] = byte_of(seed / 256 % 40);
                        i = i + 1;
                    }
                    seed = next(seed);
                    r = do_feed_raw(heap, r, b[0..seed / 256 % 25], now, 2, 0 - 1);
                }
            } else if what == 2 {
                r = do_tick(heap, r, now, 0 - 99999);
            } else if what == 3 {
                r = do_sub(heap, r, "a/#", 1, now, seed / 4096 % 2 == 0, 0 - 99999);
            } else if what == 4 {
                r = do_publish(heap, r, "t", "x", seed / 4096 % 2, now, 0 - 99999);
            } else {
                // A byte at a time.
                region a {
                    let b = alloc_slice[a](1, byte_of(0));
                    var i = 0;
                    while i < 6 {
                        seed = next(seed);
                        b[0] = byte_of(seed / 256 % 64);
                        r = do_feed_raw(heap, r, b, now, 1, 0 - 1);
                        i = i + 1;
                    }
                }
            }
            r = wipe(r);
            step = step + 1;
        }
        rig_drop(heap, r);
        round = round + 1;
    }
    return 0;
}
